# ── Ollama Configuration ────────────────────────────────────
# Base URL for Ollama's OpenAI-compatible API endpoint.
# Change this to point to LM Studio, vLLM, or any OpenAI-compatible server.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Primary chat model (used for most demos). ~4.7 GB download.
PRIMARY_MODEL=llama3.1:8b

# Secondary model (used for LLM judge in defense demos). ~4.1 GB download.
SECONDARY_MODEL=mistral:7b

# Embedding model for RAG demos (Demos 3, 7, 10). ~274 MB download.
EMBEDDING_MODEL=nomic-embed-text

# Sampling temperature (0.0 = deterministic, 2.0 = max randomness).
# Range: 0.0 - 2.0. Default: 0.7 is a good balance for demo purposes.
TEMPERATURE=0.7

# ── Azure AI Configuration (Demos 19-30) ───────────────────────
# Authentication mode: "key" for API key auth (local dev default),
# "identity" for DefaultAzureCredential (managed identity in Azure).
# AZURE_AUTH_MODE=key

# ── Azure Content Safety (Demos 19-24) ──────────────────────────
# Endpoint: Azure portal → Content Safety resource → Keys and Endpoint
# Free tier (F0) allows 5 requests/second — sufficient for demos.
# AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
# AZURE_CONTENT_SAFETY_KEY=<your-key>

# ── Azure OpenAI (Demos 25-27, 29-30) ──────────────────────────
# Endpoint: Azure portal → Azure OpenAI resource → Keys and Endpoint
# Requires approved Azure OpenAI access and a deployed model.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<your-key>
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Azure AI Search (Demo 26) ──────────────────────────────────
# Endpoint: Azure portal → AI Search resource → Keys
# Free tier available for demo purposes.
# AZURE_AI_SEARCH_ENDPOINT=https://<your-resource>.search.windows.net
# AZURE_AI_SEARCH_KEY=<your-key>
# AZURE_AI_SEARCH_INDEX=hacking-llms-index

# ── OpenTelemetry (All Demos) ────────────────────────────────
# Vendor-neutral tracing — works with any OTel-compliant backend.
# See shared/python/telemetry/README.md for backend-specific examples.
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=securing-llms
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#
# Example: LangFuse Cloud
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(public_key:secret_key)>
#
# Example: Jaeger (local)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# Example: Grafana Tempo
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
